      "CinC-2011",
      "BUT QDB",
      "European ST-T Database",
      "MIT-BIH Malignant Ventricular Ectopy Database",
      "MIT-BIH NSTDB",
      "MIT-BIH Supraventricular Arrhythmia Database",
      "PTB-XL"
    ],
    "digest": null,
    "digest_note": "no snapshot manifest was recorded for store_v2, so no training-corpus digest is available; 'training_data_hash' above is a training-run nickname, NOT a hash"
  },
  "license": {
    "code_license": "MIT (app/LICENSE) — covers the app source, not these weights",
    "weights_terms": "app/LICENSE-MODELS",
    "redistribution": "attribution-required",
    "commercial_use": "no restriction known from the training sources",
    "source_terms": [
      "all training cohorts are open-access PhysioNet datasets (ODC-BY / CC BY family)"
    ],
    "note": "provenance statement, not legal advice; verify each source's current terms before redistributing"
  },
  "inputs": [
    "x_raw",
    "x_spec"
  ],
  "spectral_preprocessing": {
    "fn": "spectral_band_channels",
    "bands_hz": [
      [
        0.0,
        0.7
      ],
      [
        0.7,
        8.0
      ],
      [
        8.0,
        40.0
      ],
      [
        40.0,
        125.0
      ],
      [
        48.0,
        62.0
      ]
    ],
    "frame_s": 0.25,
    "hop_s": 0.0625,
    "n_channels": 5,
    "note": "numpy Hann-STFT log band-power -> interp to L; app computes x_spec on the per-window z-scored signal, the graph z-scores both inputs per-window"
  },
  "heads": [
    {
      "name": "grade",
      "output_name": "q_logits",
      "kind": "ordinal",
      "activation": "softmax",
      "class_order": [
        "Q0_unacceptable",
        "Q1_poor",
        "Q2_acceptable",
        "Q3_excellent"
      ]
    },
    {
      "name": "usable",
      "output_name": "bin_logits",
      "kind": "binary",
      "activation": "softmax",
      "class_order": [
        "unusable",
        "usable"
      ]
    },
    {
      "name": "artifact",
      "output_name": "type_logits",
      "kind": "multilabel",
      "activation": "sigmoid",
      "class_order": [
        "clean",
        "motion",
        "baseline_wander",
        "muscle_emg",
        "electrode_leadoff",
        "eye_movement",
        "powerline",
        "burst_transient",
        "clipping_flatline",
        "dropout"
      ],
      "threshold": 0.5
    }
  ],
  "calibration": {
    "location": "onnx_graph",
    "temperatures": {
      "grade": 0.4,
      "usable": 3.5484
    },
    "fit_partition": "validation",
    "evaluation_partition": "validation",
    "grade_ece": [
      0.2557,
      0.0654
    ],
    "usable_ece": [
      0.1298,
      0.0237
    ],
    "partition_note": "the ECE pairs above are measured on the SAME validation split the temperature grid was minimized on, so the post-scaling number is an optimization minimum and optimistic (a held-out replication of the grade head on this graph gave 0.1343 -> 0.1121). Held-out ECE is not measured for this card; it needs a re-run of the calibration evaluation."
  },
  "routing": "grade<-raw branch; usable+type<-raw+spectral fused",
  "input_contract": {
    "expects": "raw device-native signal (unfiltered)",
    "reports": "quality of the signal AS PROVIDED \u2014 if the input was pre-filtered, this is the post-filter quality",
    "caveat": "a pre-filtered but still-corrupted signal can be under-flagged (false-clean): an aggressive low-pass/band-limit strips the high-frequency cues the model keys on. The app runs biosqa.inference.prefilter.detect_prefiltering() to warn when the input looks pre-filtered."
  },
  "ood": {
    "method": "conformal_aps",
    "grade_nonconformity_threshold": 0.9682,
    "alpha": 0.1,
    "fit_model": "v2-calibrated (the superseded single-input ECG graph)",
    "measured_empirical_coverage": 0.885,
    "coverage_note": "this tau was fit on the SUPERSEDED single-branch model and carried over unchanged. Measured on 1390 store_v2 ECG val windows through THIS graph it covers the true grade 88.5% of the time against a nominal 90% (alpha=0.1); a tau re-fit on this graph (0.9830) gives 90.1%. Re-fitting requires a model run, so the value is left as shipped and the measured coverage is stated here instead. The app deliberately surfaces the APS set as ambiguity and never prints a coverage percentage."
  },
  "novelty": {
    "method": "mahalanobis_sqi",
    "feature_names": [
