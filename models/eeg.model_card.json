{
  "modality": "eeg",
  "L_m": 1280,
  "fs_hz": 256.0,
  "class_order": [
    "Q0_unacceptable",
    "Q1_poor",
    "Q2_acceptable",
    "Q3_excellent"
  ],
  "normalization": {
    "method": "none"
  },
  "training_data_hash": "eeg-multihead-store_v8-expert-grade",
  "model_version": "v5-multihead-expert-grade-cleaned",
  "inputs": [
    "x_raw",
    "x_feat"
  ],
  "feature_preprocessing": {
    "fn": "combined_vector",
    "modality": "eeg",
    "feat_names": [
      "eeg_low_ratio",
      "eeg_high_ratio",
      "eeg_gamma_ratio",
      "eeg_tilt",
      "eeg_flatness",
      "eeg_line_index",
      "eeg_aperiodic_slope",
      "eeg_zcr",
      "eeg_kurt",
      "eeg_max_grad",
      "eeg_flatline_frac",
      "eeg_hjorth_mob",
      "eeg_hjorth_comp",
      "sk_max",
      "sk_mean",
      "sk_flat",
      "disp_ent",
      "rqa_det",
      "rqa_mean_diag",
      "rqa_long_diag",
      "jump_ratio",
      "bv_rv_ratio",
      "op_forbidden",
      "op_self_trans",
      "op_trans_ent",
      "cpp",
      "cqi"
    ],
    "n_features": 27,
    "note": "sqa_features.combined_vector (pack ++ advanced); graph z-scores x_raw and standardizes x_feat."
  },
  "heads": [
    {
      "name": "grade",
      "output_name": "q_logits",
      "kind": "ordinal",
      "activation": "softmax",
      "class_order": [
        "Q0_unacceptable",
        "Q1_poor",
        "Q2_acceptable",
        "Q3_excellent"
      ]
    },
    {
      "name": "usable",
      "output_name": "bin_logits",
      "kind": "binary",
      "activation": "softmax",
      "class_order": [
        "unusable",
        "usable"
      ]
    },
    {
      "name": "artifact",
      "output_name": "type_logits",
      "kind": "multilabel",
      "activation": "sigmoid",
      "class_order": [
        "clean",
        "motion",
        "baseline_wander",
        "muscle_emg",
        "electrode_leadoff",
        "eye_movement",
        "powerline",
        "burst_transient",
        "clipping_flatline",
        "dropout"
      ],
      "threshold": 0.5
    }
  ],
  "calibration": {
    "location": "onnx_graph",
    "temperatures": {
      "grade": 0.55,
      "usable": 5.6846
    },
    "fit_partition": "validation",
    "evaluation_partition": "test",
    "grade_ece": [
      0.1269,
      0.0598
    ],
    "usable_ece": [
      0.1632,
      0.0529
    ],
    "optimization_ece": {
      "grade": [
        0.134,
        0.0342
      ],
      "usable": [
        0.1668,
        0.0309
      ]
    }
  },
  "routing": "grade+usable+type <- raw trunk fused with host combined vector; grade = ordinal ordered-logit; type = multilabel",
  "grade_training": {
    "cohorts": [
      "TUAR",
      "PhysioMotion"
    ],
    "expert_test_qwk": 0.3372,
    "note": "grade+usable trained only on signal-descriptive expert cohorts (TUAR, PhysioMotion) with confident-learning label cleaning; the type head trains on all cohorts. Proxy/condition-derived cohorts lack a native ordinal quality scale."
  }
}