        "unusable",
        "usable"
      ]
    },
    {
      "name": "artifact",
      "output_name": "type_logits",
      "kind": "multilabel",
      "activation": "sigmoid",
      "class_order": [
        "clean",
        "motion",
        "baseline_wander",
        "muscle_emg",
        "electrode_leadoff",
        "eye_movement",
        "powerline",
        "burst_transient",
        "clipping_flatline",
        "dropout"
      ],
      "threshold": 0.5
    }
  ],
  "calibration": {
    "temperatures": {
