---
import { SITE, withBase } from '../lib/site';
interface Props { variant?: 'landing' | 'docs' }
const { variant = 'landing' } = Astro.props;
const links = [
  { href: withBase('/#features'), label: 'Features' },
  { href: withBase('/#modalities'), label: 'Modalities' },
  { href: withBase('/#how'), label: 'How it works' },
  { href: withBase('/#scale'), label: 'Quality scale' },
  { href: withBase('/docs/getting-started/'), label: 'Docs' },
];
const isDocs = variant === 'docs';
---
<header class:list={['nav', isDocs && 'nav-docs']} id="site-nav">
  <div class="nav-inner">
    {isDocs && <button class="hamburger icon-btn" data-toggle-sidebar aria-label="Toggle docs navigation">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M1 4h14M1 8h14M1 12h14" stroke="currentColor" stroke-width="1.4"/></svg>
    </button>}
    <a class="brand" href={withBase('/')} aria-label="BioSQA Studio home">
      <svg width="24" height="17" viewBox="0 0 26 18" aria-hidden="true" class="brand-glyph">
        <path d="M0 9 H4 L6 3 L9 15 L11 6 L13 9 H26" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/>
      </svg>
      <span class="brand-name">BioSQA <span class="brand-studio">Studio</span></span>
      {isDocs && <span class="docs-pill mono">docs</span>}
    </a>
    {!isDocs && <nav class="nav-links" aria-label="Primary">{links.map((l) => <a href={l.href}>{l.label}</a>)}</nav>}
    <div class="nav-right">
      {isDocs
        ? <a class="nav-link-simple" href={withBase('/')}>Home</a>
        : <a class="pill nav-ver mono" href={SITE.repo + '/releases'}>{SITE.version}</a>}
      <a class="pill nav-gh" href={SITE.repo} aria-label="BioSQA on GitHub">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        <span>GitHub</span>
      </a>
      <button class="icon-btn" data-toggle-theme aria-label="Toggle light / dark theme">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="8" cy="8" r="3"/><path d="M8 0v2M8 14v2M0 8h2M14 8h2M2.3 2.3l1.4 1.4M12.3 12.3l1.4 1.4M2.3 13.7l1.4-1.4M12.3 3.7l1.4-1.4"/></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 50; transition: background .2s ease, border-color .2s ease; border-bottom: 1px solid transparent; }
  .nav-docs { position: sticky; background: var(--nav-bg); backdrop-filter: blur(12px); border-bottom-color: var(--border); }
  .nav.scrolled { background: var(--nav-bg); backdrop-filter: blur(12px); border-bottom-color: var(--border); }
  .nav-inner { display: flex; align-items: center; gap: 28px; height: 57px; max-width: var(--maxw); margin: 0 auto; padding: 0 28px; }
  .nav-docs .nav-inner { max-width: 1360px; }
  .brand { display: inline-flex; align-items: center; gap: 9px; font-weight: 600; color: var(--text); }
  .brand:hover { color: var(--text); }
  .brand-name { font-size: 16px; letter-spacing: -0.01em; }
  .brand-studio { color: var(--text-2); font-weight: 500; }
  .docs-pill { font-size: 10px; color: var(--teal-text-c); background: var(--pill-bg-c); border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent); padding: 2px 7px; border-radius: 5px; text-transform: uppercase; letter-spacing: 0.1em; }
  .nav-links { display: flex; gap: 24px; flex: 1; justify-content: center; }
  .nav-links a { color: var(--text-2); font-size: 14px; }
  .nav-links a:hover { color: var(--text); }
  .nav-right { margin-left: auto; display: flex; align-items: center; gap: 12px; }
  .nav-docs .nav-right { margin-left: auto; }
  .nav-link-simple { color: var(--text-2); font-size: 14px; }
  .nav-link-simple:hover { color: var(--text); }
  .nav-gh { color: var(--text-2); }
  .nav-gh:hover, .nav-ver:hover { color: var(--text-2); }
  .icon-btn { background: transparent; border: 1px solid var(--border); color: var(--text-2); width: 34px; height: 34px; border-radius: var(--r-control); display: grid; place-items: center; cursor: pointer; }
  .icon-btn:hover { background: var(--hover); color: var(--text); }
  .hamburger { display: none; }
  .nav-docs .hamburger { display: none; }
  @media (max-width: 720px) { .nav-links { display: none; } .nav-gh span { display: none; } }
  @media (max-width: 840px) { .nav-docs .hamburger { display: grid; } }
</style>

<script is:inline>
  const nav = document.getElementById('site-nav');
  if (nav && !nav.classList.contains('nav-docs')) {
    const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 12);
    onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
